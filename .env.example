# Optional: WalletConnect Cloud projectId. Without one, injected wallets
# (MetaMask, Rabby, Coinbase Wallet extension) still work fine on testnet.
# Get one at https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: override the default Base Sepolia public RPC if you have one.
# Default is https://sepolia.base.org (rate-limited but free).
VITE_BASE_SEPOLIA_RPC=

# Optional: override the default Base mainnet public RPC (canary + mainnet).
# Default is https://mainnet.base.org.
VITE_BASE_MAINNET_RPC=

# Every other chain uses the public RPC from its viem chain definition. Those
# are fine for quoting and reads; swap them for your own endpoints in
# src/config/chains.ts if you hit rate limits while executing.

# URL of the test-solver Rust backend. Only used on the /test-solver page.
# Local dev: http://localhost:3000. Production: your Render URL.
VITE_TEST_SOLVER_URL=
